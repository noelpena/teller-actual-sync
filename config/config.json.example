{
  "plaid": {
    "clientId": "your_plaid_client_id_here",
    "secret": "your_plaid_secret_here",
    "env": "sandbox",
    "daysRequested": 90
  },
  "items": [
    {
      "itemId": "managed_by_app_after_plaid_link",
      "accessToken": "access-sandbox-...",
      "institution": "First Platypus Bank",
      "cursor": null
    }
  ],
  "actual": {
    "dataDir": "/app/actual-data",
    "serverURL": "http://your-actual-server:5006",
    "password": "your_actual_password",
    "syncId": "your_budget_sync_id"
  },
  "mappings": [
    {
      "id": "m_example",
      "name": "My Checking",
      "itemId": "managed_by_app_after_plaid_link",
      "plaidAccountId": "plaid_account_id_here",
      "actualAccountId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    }
  ],
  "sync": {
    "cronSchedule": "0 8 * * *"
  }
}
